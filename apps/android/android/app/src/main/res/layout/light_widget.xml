<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp"
        android:layout_gravity="center" android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="10dp" android:background="@drawable/widget_surface">
        <LinearLayout android:id="@+id/light_details" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="vertical" android:layout_marginEnd="8dp">
            <TextView android:id="@+id/light_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="KS Light" android:fontFamily="sans-serif-medium" android:textColor="#ECF0EC"
                android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
            <TextView android:id="@+id/light_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Ready" android:textColor="#95A09B"
                android:textSize="10sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"/>
        </LinearLayout>
        <TextView android:id="@+id/light_on" android:layout_width="48dp" android:layout_height="48dp"
            android:background="@drawable/widget_action" android:gravity="center" android:text="On" android:textColor="#D4EFA3"
            android:fontFamily="sans-serif-medium" android:textSize="14sp" android:contentDescription="Turn light on" android:clickable="true"/>
        <TextView android:id="@+id/light_off" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginStart="6dp" android:background="@drawable/widget_action" android:gravity="center" android:text="Off"
            android:textColor="#ECF0EC" android:fontFamily="sans-serif-medium" android:textSize="14sp" android:contentDescription="Turn light off" android:clickable="true"/>
    </LinearLayout>
</FrameLayout>